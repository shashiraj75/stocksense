# StockSense360 frontend environment configuration.
#
# All variables below are prefixed NEXT_PUBLIC_ — by Next.js convention,
# anything with that prefix is inlined into the browser bundle at build time
# and is therefore PUBLIC / browser-visible to anyone who loads the site.
# Never put a real secret in a NEXT_PUBLIC_* variable.

# ── Core required config ─────────────────────────────────────────────────────

# Backend API base URL. Browser-visible. REQUIRED for a deployed/Production
# frontend — every API call targets this URL, and without it in that
# context no data loads and no user action (predictions, portfolio,
# watchlist, alerts) works. OPTIONAL for normal local development: the code
# falls back to http://localhost:8000 when unset (frontend/src/utils/
# api.ts), so it only needs to be set locally if your backend runs
# elsewhere.
NEXT_PUBLIC_API_URL=https://your-backend-api.example.com

# Supabase project URL. Browser-visible. REQUIRED — used to initialize the
# Supabase client for authentication; without it, login/signup and any
# authenticated request breaks.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous/public key. Browser-visible by design — this key is
# scoped by Supabase Row Level Security (RLS) policies, so exposing it in the
# browser bundle is the intended, safe usage pattern. REQUIRED — without it,
# the Supabase client cannot authenticate and auth breaks.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Optional UI feature flags ────────────────────────────────────────────────
# These are display-only gates on the frontend. The backend independently
# re-enforces the corresponding server-side flag, so leaving these unset (or
# mismatched with the backend) only affects what UI renders — it cannot expose
# functionality the backend hasn't already enabled.

# Market Leadership UI display gate — mirrors the backend's
# MARKET_LEADERSHIP_UI_ENABLED flag. Browser-visible. OPTIONAL, UI-display-only.
# Set to 1/true to show the Market Leadership UI component.
NEXT_PUBLIC_MARKET_LEADERSHIP_UI_ENABLED=0

# Trade Postmortem daily-view UI gate. Browser-visible. OPTIONAL,
# UI-display-only. Set to 1/true to show the postmortem daily view.
NEXT_PUBLIC_TRADE_POSTMORTEM_DAILY_ENABLED=0

# Trade Postmortem price-path UI gate — mirrors the backend's
# TRADE_POSTMORTEM_PRICE_PATH_ENABLED flag. Browser-visible. OPTIONAL,
# UI-display-only. Set to 1/true to show the postmortem price-path chart.
NEXT_PUBLIC_TRADE_POSTMORTEM_PRICE_PATH_ENABLED=0
