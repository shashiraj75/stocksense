# StockSense360 backend environment configuration.
# Safe placeholders only — never commit real credentials to this file.
#
# Many integrations are optional and fail safely when not configured.
# Production-required settings and feature flags are documented below
# with their actual code defaults.

ENVIRONMENT=development

# Optional: Postgres (Supabase) persistence for the Learning Alpha Engine.
# Use the Supabase connection POOLER string (port 6543, sslmode=require) —
# get it from Supabase dashboard > Project Settings > Database > Connection Pooling.
# Leave both unset to keep using local SQLite (alpha_engine.db).
USE_POSTGRES=0
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require

# Secret for triggering daily pick generation (GitHub Actions cron)
PICKS_SECRET=change-me-in-production

# Required in production: verifies Supabase-issued JWTs on Portfolio/Watchlist/
# Alerts/Terms endpoints (Security Remediation Sprint #001 — fixes the Mini
# Security Audit's C-1 finding).
#
# SUPABASE_URL is required for current Supabase projects (JWT Signing Keys,
# ES256, the default since the JWT Signing Keys follow-up sprint) — same
# value as the frontend's NEXT_PUBLIC_SUPABASE_URL, used to build the JWKS
# endpoint (<SUPABASE_URL>/auth/v1/.well-known/jwks.json).
#
# SUPABASE_JWT_SECRET is only needed for projects still on the legacy shared
# HS256 secret (Project Settings > API > JWT Settings > JWT Secret) — leave
# unset if the project has migrated to JWT Signing Keys.
#
# Requests are rejected (fail-closed) if neither is configured for the
# algorithm a given token actually uses.
SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_JWT_SECRET=change-me-only-if-still-on-legacy-hs256-secret

# CORS: the production frontend origin(s). FRONTEND_URL is required for the
# deployed frontend to be allowed at all; STAGING_FRONTEND_URL is optional.
# Never set VERCEL_PREVIEW_ORIGIN_REGEX to a bare `.*\.vercel\.app` pattern —
# that was H-1 in the Mini Security Audit (a shared-domain wildcard combined
# with allow_credentials=True). If you need Vercel preview-deployment access,
# scope the regex to this project's own preview URL naming pattern only.
FRONTEND_URL=https://your-production-frontend.example.com
# STAGING_FRONTEND_URL=https://your-staging-frontend.example.com
# VERCEL_PREVIEW_ORIGIN_REGEX=https://your-project-name-[a-z0-9-]+\.vercel\.app

# Max stocks to include in daily picks universe.
# Leave unset to use all 98 Nifty 100 stocks.
# Set to 25 on memory-constrained hosts (e.g. Render free tier).
# PICKS_UNIVERSE_LIMIT=25

# Growth Intelligence Engine confidence-adjustment kill switch (Epic 003,
# Sprint #006's integration decision, implemented Sprint #007). Two
# independent switches, one per market — flipping either requires no code
# change. Defaults (used if left unset, exactly as shipped): India enabled,
# US disabled. The US switch exists for completeness/defense-in-depth, not
# because Sprint #006 authorizes enabling it — a future sprint's outcome
# re-validation (per Sprint #005's open finding) is required first.
# GROWTH_INTELLIGENCE_CONFIDENCE_ENABLED_IN=1
# GROWTH_INTELLIGENCE_CONFIDENCE_ENABLED_US=0

# Valuation Intelligence confidence-adjustment kill switches (Epic 004,
# Sprint #006's integration decision, implemented Sprint #007). Two
# independent switches, one per market — flipping either requires no code
# change. Defaults (used if left unset, exactly as shipped): BOTH DISABLED —
# a more conservative posture than Growth Intelligence's own enabled-by-
# default-for-India rollout, justified by this engine's uniquely severe
# demonstrated downside risk (Sprint #005's RELINFRA case: a 73/100 score
# followed by a real, measured -82.0% return). Enabling either requires an
# explicit operator opt-in, not an assumed-on default.
# VALUATION_INTELLIGENCE_CONFIDENCE_ENABLED_IN=0
# VALUATION_INTELLIGENCE_CONFIDENCE_ENABLED_US=0

# Recommendation Consolidation Intelligence — live Stock Analysis API flag
# (Epic 005, Sprint #007's integration-readiness decision, implemented
# Sprint #008). A single, global switch — not market-split, since RCI
# applies no market-specific numeric adjustment to gate. Controls ONLY
# whether the additive `recommendation_consolidation` field is composed
# and attached to the live `/predict` API response; it never affects
# signal, confidence, composite score, or any existing gate. Default
# (used if left unset, exactly as shipped): DISABLED — not enabled in
# any committed configuration, per Sprint #008's own explicit
# "do not enable the flag in production during this sprint" rule.
# RCI_LIVE_STOCK_ANALYSIS_ENABLED=0

# ── Intelligence Engine — shadow logging ────────────────────────────────────

# Master shadow-mode logging switch for the Intelligence Engine
# (services/daily_picks.py:1431, services/postgres_store.py). Observability
# only — writes shadow snapshots/telemetry for later analysis, never affects
# picks, confidence, or any served result. Default (unset): OFF ("0").
# INTELLIGENCE_ENGINE_SHADOW_ENABLED=0

# ── Market Leadership and Trend Context Layer ───────────────────────────────
# (services/market_leadership/configuration.py). All five flags default OFF
# and are independent (each nested flag also requires the master
# MARKET_LEADERSHIP_ENGINE_ENABLED=1 to have any effect).

# Master gate — the module may compute at all. Default: OFF ("0" / unset).
# MARKET_LEADERSHIP_ENGINE_ENABLED=0

# Scoring influence — RESERVED. Deliberately not consumed by any production
# scoring path in this release; wiring it in without Gate 7 approval is a
# review-blocking defect. financial-decision-impacting if ever wired in.
# Default: OFF.
# MARKET_LEADERSHIP_SCORING_ENABLED=0

# API may return Market Leadership payloads to the frontend component.
# UI-display-only (not financial-decision-impacting). Default: OFF.
# MARKET_LEADERSHIP_UI_ENABLED=0

# Shadow snapshot computation + telemetry persistence. Observability only.
# Default: OFF.
# MARKET_LEADERSHIP_SHADOW_ENABLED=0

# Shadow-experiment harness may read persisted snapshots. Observability/
# validation only. Default: OFF.
# MARKET_LEADERSHIP_VALIDATION_ENABLED=0

# ── Trade Postmortem ─────────────────────────────────────────────────────────
# These are two SEPARATE, independent flags for two separate Postmortem
# surfaces — enabling one has no effect on the other.

# Gates the daily aggregate Postmortem surface (api/routers/
# paper_trading.py's _TRADE_POSTMORTEM_DAILY_ENV_VAR /
# _trade_postmortem_daily_enabled()) — the multi-trade daily rollup view,
# NOT the per-trade price-path feature below. User-facing feature
# availability only, not prediction/ranking/scoring logic. Accepts
# 1/true/yes/on (case-insensitive). Default: OFF ("0"). Corresponding
# frontend display flag: NEXT_PUBLIC_TRADE_POSTMORTEM_DAILY_ENABLED.
# TRADE_POSTMORTEM_DAILY_ENABLED=0

# Gates the postmortem price-path feature (api/main.py, api/routers/
# paper_trading.py, services/postmortem/outbox_worker.py) — computing and
# serving the intraday price path for a closed paper trade. Indirectly
# affects paper-trade analysis, not live financial decisions. Accepts
# 1/true/yes/on (case-insensitive). Default: OFF ("0").
# TRADE_POSTMORTEM_PRICE_PATH_ENABLED=0

# ── Daily Picks ───────────────────────────────────────────────────────────

# Max stocks screened per download batch (services/daily_picks.py). Tuning
# only — avoids OOM on memory-constrained hosts. Not financial-decision-
# impacting. Default: 300.
# SCREEN_BATCH_SIZE=300

# How many top-momentum stocks get a full deep-predict pass, out of the
# screened universe (services/daily_picks.py). financial-decision-impacting —
# directly controls candidate pool size for picks generation. Default: 400.
# PICKS_CANDIDATES=400

# Runs a missed daily-picks batch job on startup if one was skipped (e.g.
# after downtime). financial-decision-impacting — affects which picks run and
# when. Default: OFF ("0") — see api/main.py's startup_catchup_enabled().
# DAILY_PICKS_STARTUP_CATCHUP_ENABLED=0

# Market-cap eligibility floor for the India (IN) universe, in Crores INR —
# excludes micro-caps/shells below this floor (services/daily_picks.py).
# financial-decision-impacting — affects universe composition. Default: 100.
# MIN_MCAP_CR=100

# Market-cap eligibility floor for the US universe, in USD millions — same
# purpose as MIN_MCAP_CR but US-scoped (services/daily_picks.py).
# financial-decision-impacting — affects universe composition. Default: 100.
# MIN_MCAP_USD_M_FLOOR=100

# ── Confidence scoring ────────────────────────────────────────────────────
# Composite data-confidence score weights (services/intelligence_engine/
# data_confidence.py). All financial-decision-impacting (they directly
# determine the confidence score attached to predictions). Weights are not
# required to sum to any particular total in code — they're combined as
# independently-weighted components. Defaults are the values shipped:
# CONFIDENCE_WEIGHT_PRICE=25
# CONFIDENCE_WEIGHT_VOLUME=20
# CONFIDENCE_WEIGHT_FUNDAMENTALS=20
# CONFIDENCE_WEIGHT_FINANCIALS=15
# CONFIDENCE_WEIGHT_FRESHNESS=10
# CONFIDENCE_WEIGHT_HISTORY=10

# Days of price history considered "full" for the history-completeness
# component above (~1 trading year). financial-decision-impacting. Default: 252.
# CONFIDENCE_FULL_HISTORY_DAYS=252

# Max age (days) for a quote to count as "fresh" for the freshness component
# above. financial-decision-impacting. Default: 1.
# CONFIDENCE_FRESH_QUOTE_MAX_DAYS=1

# ── Liquidity / tradability gates ────────────────────────────────────────
# (services/intelligence_engine/liquidity_gate.py,
# services/intelligence_engine/tradability_gate.py). Both financial-decision-
# impacting — they determine which stocks pass the screen.

# Minimum free-float percentage required to pass the liquidity gate. No
# literal numeric default in code — if left unset, this filter is not applied
# at all (None / skipped), so setting it makes screening *more* restrictive.
# LIQUIDITY_MIN_FREE_FLOAT_PCT=10

# Max number of zero-volume days tolerated before a stock fails the liquidity
# gate. Default: 2.
# LIQUIDITY_MAX_ZERO_VOLUME_DAYS=2

# Max age (days) for a quote to still be considered tradable (not stale).
# Default: 5.
# TRADABILITY_STALE_QUOTE_MAX_DAYS=5

# ── Market data providers ────────────────────────────────────────────────

# Finnhub API key (SECRET). Data-source-impacting — used as a supplementary
# quote/market-data provider. Empty string is the code default (provider is
# effectively disabled without a key).
FINNHUB_API_KEY=your-finnhub-api-key-here

# Enables Finnhub as a data source for the India (IN) market specifically
# (services/finnhub_client.py). PRIVATE, not a secret itself but gates a
# paid/rate-limited provider. Accepts "true" (case-insensitive); anything
# else is treated as false. Default: OFF ("false").
# ENABLE_FINNHUB_FOR_IN=false

# Screener.in login credentials (SECRET), India-scoped. Data-source-
# impacting — without them, screener.in requests are unauthenticated and may
# be rate-limited or incomplete (services/screener_data.py).
SCREENER_EMAIL=your-screener-in-email@example.com
SCREENER_PASSWORD=change-me-in-production

# ── SEC EDGAR (US) ────────────────────────────────────────────────────────

# Contact email sent in the User-Agent header to SEC EDGAR, required by SEC's
# fair-use policy for programmatic access (services/sec_edgar_adapter.py).
# PRIVATE, US-scoped, compliance-relevant (not financial-decision-impacting).
# A default User-Agent is used if unset, but production should set this.
SEC_EDGAR_CONTACT=your-contact-email@example.com

# Local SQLite path override for the point-in-time SEC facts database
# (services/sec_pit_store.py). PRIVATE, US-scoped. Default: "sec_pit_facts.db"
# (relative to the backend working directory).
# SEC_PIT_SQLITE_PATH=sec_pit_facts.db

# ── Notifications ─────────────────────────────────────────────────────────

# Resend transactional email API key (SECRET). Used for invite, price-alert,
# and trade-notification emails (services/price_alert_notifier.py,
# services/trade_notifier.py). Not financial-decision-impacting. Empty string
# is the code default (email sending is skipped without a key).
RESEND_API_KEY=your-resend-api-key-here

# Telegram bot token and chat ID (SECRET / PRIVATE) for alert delivery via
# Telegram (services/telegram_bot.py). Not financial-decision-impacting. Both
# default to empty string (Telegram delivery is skipped if either is unset).
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-telegram-chat-id-here

# Kill switch for price-alert enforcement/delivery (api/main.py,
# services/price_alert_notifier.py). Not financial-decision-impacting — this
# gates notification delivery, not the underlying picks/predictions. Fail-
# open by default: set to "0" to disable. Default: ON ("1").
# PRICE_ALERTS_ENFORCEMENT=1

# ── Compliance / audit ────────────────────────────────────────────────────

# Separate database connection string (SECRET) for a read-only audit role,
# used by one-off compliance/repair scripts (scripts/
# plan_market_contamination_repair.py). Compliance-relevant, not financial-
# decision-impacting. Empty string is the code default (script refuses to run
# without it, by design — it only ever connects via this dedicated audit role).
AUDIT_DATABASE_URL=your-audit-database-connection-string-here

# ── Platform-injected (Railway) — do not set manually ────────────────────
# These are populated automatically by the Railway platform at deploy time.
# Setting them yourself in a local .env has no effect on Railway deployments
# and is only useful for local self-ping/version-display testing.

# Public URL of this service, used for self-ping/keep-alive (api/main.py).
# Railway-injected via RAILWAY_PUBLIC_DOMAIN normally; SELF_URL is a manual
# fallback for non-Railway platforms. Default: unset (self-ping skipped).
# SELF_URL=

# Railway-injected public domain for this deployment. Do not set manually in
# production — Railway provides this automatically.
# RAILWAY_PUBLIC_DOMAIN=

# Railway-injected git commit SHA of the running deployment, surfaced in
# validation/telemetry records for traceability. Do not set manually in
# production — Railway provides this automatically.
# RAILWAY_GIT_COMMIT_SHA=

# ── Observability / scheduling ────────────────────────────────────────────

# Log verbosity (services/logging_config.py). Not financial-decision-
# impacting. Default: "INFO".
# LOG_LEVEL=INFO

# Timezone used by cron/scheduling logic. Not read directly as a simple
# os.getenv default in this service's own code — it's environment/platform-
# level (e.g. GitHub Actions cron, Railway container TZ). Worth setting
# explicitly since it affects the wall-clock timing of market-hours-aware
# scheduling logic, not the logic itself. No app-level default to report.
# TZ=UTC
